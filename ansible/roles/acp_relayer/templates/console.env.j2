RELAYER_BASE_URL=http://127.0.0.1:{{ acp_relayer_api_port }}
L1_RPC_URL=http://127.0.0.1:9650/ext/bc/{{ acp_relayer_blockchain_id }}/rpc
# WALLET_RPC_URL is deliberately NOT set.
#
# It used to be pinned to http://127.0.0.1:9650/ext/bc/<id>/rpc, which is only reachable from the
# operator's browser while `make relayer-access` holds its -L 9650 forward. Whenever that forward
# was absent (tunnel dropped, different access path), the wallet had an undialable RPC saved for
# this chain and every wallet-side call failed as viem's opaque
# "An internal error was received. Details: Failed to fetch" (JSON-RPC -32603).
#
# Left unset, the console serves the wallet from its OWN origin (/api/wallet-rpc, capability-token
# authed) and the browser absolutizes it against window.location.origin. That is the same port
# already carrying the page — forwarded by `make relayer-access` as -L 3080 — so it needs no second
# forward and stays correct under any access topology. Set this only to point the wallet at the L1
# RPC directly, or when the console is behind a self-signed cert the extension will refuse.
# See console/README.md "Wallet RPC" in the relayer repo.
RELAYER_CONSOLE_ORIGIN=http://127.0.0.1:{{ acp_relayer_console_port }}
RELAYER_CONSOLE_INSECURE_COOKIE=1
RELAYER_CONSOLE_SESSION_SECRET={{ lookup('file', acp_relayer_console_session_secret_src) | trim }}
{% if acp_relayer_console_password_hash_src | length > 0 %}
RELAYER_CONSOLE_PASSWORD_HASH={{ lookup('file', acp_relayer_console_password_hash_src) | trim }}
{% elif acp_relayer_console_hash_kept.content is defined %}
RELAYER_CONSOLE_PASSWORD_HASH={{ acp_relayer_console_hash_kept.content | b64decode | trim }}
{% endif %}
{% if acp_relayer_safe_enabled | bool %}
SAFE_TX_SERVICE_URL={{ acp_relayer_safe_tx_service_url }}
SAFE_UI_URL={{ acp_relayer_safe_ui_url }}
SAFE_ADDRESS={{ acp_relayer_safe_address }}
{% endif %}
