# macOS
.DS_Store

# Compiled binaries / build artifacts.
# These are built from source via `go build` and the Dockerfiles —
# never commit them.
/avalanche-remote-signer
/avalanche-kms-signer
/avalanche-kms-signer-bin
/vault-plugin-bls
/vault-plugin/vault-plugin-bls

# Go test & coverage output
*.out
*.test
coverage.html

# Encrypted key blobs (local testing only — never commit key material)
*.key.enc

# Editor / IDE
*.swp
*.swo
.idea/
.vscode/

# NOTE: vendor/ is intentionally committed and is NOT ignored here.
# The Dockerfile builds with `-mod=vendor` for network-free, reproducible
# (enclave) builds, and scripts/vendor-blst.sh layers blst's C sources on top
# of `go mod vendor`. Do not add vendor/ to this file.
